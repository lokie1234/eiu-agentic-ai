  'Nội dung chuyển khoản'
];

const DEMO_APPS = {
  leave: {
    title: 'Quản lý nghỉ phép',
    subtitle:
      'Theo dõi đơn nghỉ, trạng thái phê duyệt và số ngày phép còn lại.'
  },

  time: {
    title: 'Quản lý thời gian làm việc',
    subtitle:
      'Ghi nhận thời gian làm việc, tiến độ và hiệu suất theo ngày.'
  },

  meeting: {
    title: 'Quản lý cuộc họp',
    subtitle:
      'Sắp xếp lịch họp, người tham dự và các nội dung cần theo dõi.'
  },

  overtime: {
    title: 'Quản lý tăng ca',
    subtitle:
      'Theo dõi số giờ tăng ca, trạng thái phê duyệt và báo cáo theo kỳ.'
  }
};


/**
 * Hiển thị trang chủ, đăng ký hoặc trang demo.
 */
function doGet(e) {
  const params =
    e && e.parameter
      ? e.parameter
      : {};

  const requestedPage =
    String(params.page || '')
      .toLowerCase();

  let page = 'Index';

  if (requestedPage === 'register') {
    page = 'Register';

  } else if (requestedPage === 'demo') {
    page = 'Demo';
  }

  const template =
    HtmlService.createTemplateFromFile(page);

  template.appUrl =
    ScriptApp.getService().getUrl() || '';

  template.logoUrl =
    getLogoDataUrl_();

  let title =
    'Applied Agentic AI for Business';

  if (page === 'Register') {
    title =
      'Đăng ký khóa học Applied Agentic AI';
  }

  if (page === 'Demo') {
    const requestedType =
      String(params.type || 'leave')
        .toLowerCase();

    const demoType =
      Object.prototype.hasOwnProperty.call(
        DEMO_APPS,
        requestedType
      )
        ? requestedType
        : 'leave';

    template.demoType =
      demoType;

    template.demo =
      DEMO_APPS[demoType];

    title =
      DEMO_APPS[demoType].title +
      ' · Demo Web App EIU';
  }

  return template
    .evaluate()
    .setTitle(title)
    .addMetaTag(
      'viewport',
      'width=device-width, initial-scale=1, viewport-fit=cover'
    )
    .setXFrameOptionsMode(
      HtmlService.XFrameOptionsMode.ALLOWALL
    );
}


/**
 * API nhận dữ liệu từ Cloudflare Pages Function/Worker.
 *
 * Cloudflare gửi JSON theo dạng:
 * {
 *   action: 'register',
 *   apiKey: '...',
 *   data: { ...dữ liệu biểu mẫu... }
 * }
 */
function doPost(e) {
  try {
    const requestBody =
      parseJsonRequest_(e);

    const expectedApiKey =
      PropertiesService
        .getScriptProperties()
        .getProperty(
          'CLOUDFLARE_API_KEY'
        );

    if (!expectedApiKey) {
      throw new Error(
        'Chưa cấu hình khóa kết nối Cloudflare trong Apps Script.'
      );
    }

    const submittedApiKey =
      String(
        requestBody.apiKey || ''
      );

    if (
      !secureTextEquals_(
        expectedApiKey,
        submittedApiKey
      )
    ) {
      return jsonOutput_({
        success: false,
        unauthorized: true,
        message:
          'Yêu cầu không được phép.'
      });
    }

    const action =
      String(
        requestBody.action || ''
      )
        .toLowerCase()
        .trim();

    if (action !== 'register') {
      return jsonOutput_({
        success: false,
        message:
          'Tác vụ API không hợp lệ.'
      });
    }

    const formData =
      requestBody.data;

    if (
      !formData ||
      typeof formData !== 'object' ||
      Array.isArray(formData)
    ) {
      return jsonOutput_({
        success: false,
        message:
          'Dữ liệu biểu mẫu không hợp lệ.'
      });
    }

    return jsonOutput_(
      saveRegistration(
        formData
      )
    );

  } catch (error) {
    console.error(
      'Cloudflare API error: ' +
      String(
        error &&
        error.stack
          ? error.stack
          : error
      )
    );

    return jsonOutput_({
      success: false,
      message:
        error &&
        error.message
          ? error.message
          : 'Không thể xử lý yêu cầu đăng ký.'
    });
  }
}


/**
 * Chạy thủ công đúng một lần để tạo khóa kết nối.
 *
 * Sau khi chạy:
 * 1. Sao chép giá trị trả về trong Execution log/result.
 * 2. Dán vào Cloudflare với tên APPS_SCRIPT_API_KEY.
 *
 * Nếu chạy lại, khóa cũ sẽ hết hiệu lực và phải cập nhật
 * lại Secret trên Cloudflare.
 */
function createCloudflareApiKey() {
  const apiKey =
    [
      Utilities.getUuid(),
      Utilities.getUuid(),
      String(
        new Date().getTime()
      )
    ]
      .join('-')
      .replace(
        /[^A-Za-z0-9-]/g,
        ''
      );

  PropertiesService
    .getScriptProperties()
    .setProperty(
      'CLOUDFLARE_API_KEY',
      apiKey
    );

  console.log(
    'APPS_SCRIPT_API_KEY=' +
    apiKey
  );

  return apiKey;
}


/**
 * Đọc JSON từ nội dung POST.
 */
function parseJsonRequest_(e) {
  const contents =
    e &&
    e.postData &&
    e.postData.contents
      ? String(
          e.postData.contents
        )
      : '';

  if (!contents) {
    throw new Error(
      'Yêu cầu POST không có dữ liệu.'
    );
  }

  if (contents.length > 20000) {
    throw new Error(
      'Dữ liệu gửi lên vượt quá giới hạn.'
    );
  }

  let parsed;

  try {
    parsed =
      JSON.parse(
        contents
      );

  } catch (error) {
    throw new Error(
      'Nội dung JSON không hợp lệ.'
    );
  }

  if (
    !parsed ||
    typeof parsed !== 'object' ||
    Array.isArray(parsed)
  ) {
    throw new Error(
      'Cấu trúc yêu cầu không hợp lệ.'
    );
  }

  return parsed;
}


/**
 * So sánh chuỗi theo cách không dừng ngay ở ký tự đầu tiên khác nhau.
 */
function secureTextEquals_(
  expected,
  submitted
) {
  const left =
    String(
      expected || ''
    );

  const right =
    String(
      submitted || ''
    );

  let difference =
    left.length ^
    right.length;

  const maximumLength =
    Math.max(
      left.length,
      right.length
    );

  for (
    let index = 0;
    index < maximumLength;
    index += 1
  ) {
    const leftCode =
      index < left.length
        ? left.charCodeAt(index)
        : 0;

    const rightCode =
      index < right.length
        ? right.charCodeAt(index)
        : 0;

    difference |=
      leftCode ^
      rightCode;
  }

  return difference === 0;
}


/**
 * Trả JSON cho Cloudflare Worker.
 */
function jsonOutput_(value) {
  return ContentService
    .createTextOutput(
      JSON.stringify(
        value
      )
    )
    .setMimeType(
      ContentService.MimeType.JSON
    );
}


/**
 * Chạy thủ công một lần để chuẩn hóa Sheet.
 */
function setupRegistrationSheet() {
  const sheet =
    getRegistrationSheet_();

  ensureSheetReady_(sheet);

  SpreadsheetApp.flush();

  return 'Đã chuẩn hóa Sheet đăng ký.';
}


/**
 * Nhận, kiểm tra và lưu thông tin đăng ký.
 */
function saveRegistration(formData) {
  if (
    !formData ||
    typeof formData !== 'object'
  ) {
    throw new Error(
      'Thông tin đăng ký không hợp lệ.'
    );
  }

  /*
   * Trường ẩn chống bot.
   */
  if (normalizeText_(formData.website)) {
    throw new Error(
      'Không thể xử lý yêu cầu này.'
    );
  }

  const fullName =
    normalizeText_(formData.fullName);

  const email =
    normalizeText_(formData.email)
      .toLowerCase();

  const nameKey =
    normalizeNameKey_(fullName);

  const normalizedPhone =
    normalizeVietnamPhone_(
      formData.phone
    );

  /*
   * Nội dung chuyển khoản được tạo ở Register.html
   * theo dạng:
   *
   * TEN HOC VIEN EIUAA1234
   */
  let transferContent =
    normalizeText_(
      formData.transferContent
    )
      .toUpperCase();

  if (
    transferContent.length < 10 ||
    transferContent.length > 50 ||
    !/^[A-Z0-9 ]+ EIUAA\d{4}$/
      .test(
        transferContent
      )
  ) {
    throw new Error(
      'Nội dung chuyển khoản không hợp lệ.'
    );
  }

  validateRegistration_(
    fullName,
    nameKey,
    normalizedPhone,
    email
  );

  const isEiuStudent =
    isEiuEmail_(email);

  // Luôn chốt giá ở backend, không dùng số tiền từ trình duyệt.
  let pricing;
  let tuition;

  const registrationKey =
    createRegistrationKey_(
      nameKey,
      normalizedPhone
    );

  /*
   * Ngăn hai lượt đăng ký ghi đồng thời.
   */
  const lock =
    LockService.getScriptLock();

  if (!lock.tryLock(8000)) {
    return {
      success: false,
      busy: true,
      message:
        'Hệ thống đang tiếp nhận nhiều lượt đăng ký. ' +
        'Vui lòng chờ vài giây rồi thử lại.'
    };
  }

  let sheet;
  let nextRow;

  try {
    sheet =
      getRegistrationSheet_();

    ensureSheetReady_(sheet);

    if (
      registrationExists_(
        sheet,
        registrationKey
      )
    ) {
      return {
        success: false,
        duplicate: true,
        message:
          'Họ tên và số điện thoại này đã được đăng ký trước đó. ' +
          'Bạn không cần gửi lại biểu mẫu.'
      };
    }

    /*
     * Kiểm tra mã EIUAAxxxx trên toàn bộ Sheet.
     * Nếu mã do trình duyệt gửi lên đã tồn tại,
     * tạo mã 4 số khác ngay trong vùng khóa.
     */
    const lastRegistrationRow =
      sheet.getLastRow();

    const usedPaymentCodes =
      new Set();

    if (lastRegistrationRow >= 2) {
      const existingTransferContents =
        sheet
          .getRange(
            2,
            10,
            lastRegistrationRow - 1,
            1
          )
          .getDisplayValues();

      existingTransferContents.forEach(
        function (row) {
          const matchedCode =
            String(
              row[0] || ''
            )
              .match(
                /EIUAA(\d{4})\b/i
              );

          if (matchedCode) {
            usedPaymentCodes.add(
              matchedCode[1]
            );
          }
        }
      );
    }

    const submittedCodeMatch =
      transferContent.match(
        /EIUAA(\d{4})$/
      );

    let paymentCode =
      submittedCodeMatch
        ? submittedCodeMatch[1]
        : '';

    if (
      !paymentCode ||
      usedPaymentCodes.has(
        paymentCode
      )
    ) {
      if (
        usedPaymentCodes.size >= 10000
      ) {
        throw new Error(
          'Đã sử dụng hết mã thanh toán 4 số.'
        );
      }

      paymentCode = '';

      for (
        let attempt = 0;
        attempt < 300;
        attempt += 1
      ) {
        const candidate =
          String(
            Math.floor(
              Math.random() *
              10000
            )
          )
            .padStart(
              4,
              '0'
            );

        if (
          !usedPaymentCodes.has(
            candidate
          )
        ) {
          paymentCode =
            candidate;

          break;
        }
      }

      if (!paymentCode) {
        for (
          let number = 0;
          number < 10000;
          number += 1
        ) {
          const candidate =
            String(
              number
            )
              .padStart(
                4,
                '0'
              );

          if (
            !usedPaymentCodes.has(
              candidate
            )
          ) {
            paymentCode =
              candidate;

            break;
          }
        }
      }

      if (!paymentCode) {
        throw new Error(
          'Không thể tạo mã thanh toán mới.'
        );
      }

      transferContent =
        transferContent.replace(
          /EIUAA\d{4}$/,
          'EIUAA' +
          paymentCode
        );
    }

    // Tính ngay trước khi ghi để cả lượt đăng ký qua mốc hết hạn vẫn chính xác.
    pricing = getTuitionInfo_(email, new Date());
    tuition = pricing.tuition;

    nextRow =
      Math.max(
        sheet.getLastRow() + 1,
        2
      );

    const registrationRow = [
      new Date(),

      safeSheetText_(
        fullName
      ),

      safeSheetText_(
        normalizedPhone
      ),

      safeSheetText_(
        email
      ),

      'Mới',

      isEiuStudent
        ? 'Email EIU'
        : 'Email ngoài EIU',

      tuition,

      registrationKey,

      'Đang gửi',

      safeSheetText_(
        transferContent
      )
    ];

    sheet
      .getRange(
        nextRow,
        1,
        1,
        registrationRow.length
      )
      .setValues([
        registrationRow
      ]);

    SpreadsheetApp.flush();

  } finally {
    lock.releaseLock();
  }

  /*
   * Gửi email sau khi đã lưu dữ liệu.
   *
   * Nếu gửi email lỗi, thông tin đăng ký
   * vẫn được giữ trong Google Sheets.
   */
  let emailSent = false;
  let emailStatus = 'Chưa gửi';

  try {
    if (
      MailApp.getRemainingDailyQuota() < 1
    ) {
      throw new Error(
        'Tài khoản gửi thư đã hết hạn mức email trong ngày.'
      );
    }

    sendRegistrationConfirmation_(
      email,
      fullName,
      pricing
    );

    emailSent = true;
    emailStatus = 'Đã gửi';

  } catch (emailError) {
    emailStatus =
      'Lỗi: ' +
      String(
        emailError &&
        emailError.message
          ? emailError.message
          : emailError
      ).slice(0, 180);

    console.error(
      'Không gửi được email xác nhận: ' +
      emailStatus
    );
  }

  /*
   * Ghi lại trạng thái email tại cột I.
   */
  try {
    sheet
      .getRange(
        nextRow,
        9
      )
      .setValue(
        emailStatus
      );

  } catch (statusError) {
    console.error(
      'Không cập nhật được trạng thái email: ' +
      statusError.message
    );
  }

  return {
    success: true,

    emailSent:
      emailSent,

    isEiu:
      isEiuStudent,

    tuition:
      tuition,

    formattedTuition:
      formatCurrency_(tuition),

    earlyBirdActive:
      pricing.isEarlyBird,

    baseTuition:
      pricing.baseTuition,

    transferContent:
      transferContent,

    message:
      emailSent
        ? 'Đăng ký thành công. Email xác nhận đã được gửi đến ' +
          email +
          '.'
        : 'Đăng ký thành công. Thông tin của bạn đã được ghi nhận; ' +
          'Ban tổ chức sẽ liên hệ lại với bạn.'
  };
}


/**
 * Lấy Sheet lưu đăng ký.
 * Tự động nhận diện Google Sheet đang chứa script này
 * (mở từ Tiện ích mở rộng > Apps Script).
 */
function getRegistrationSheet_() {
  let spreadsheet = null;

  try {
    spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  } catch (err) {
    // getActiveSpreadsheet có thể không khả dụng trong ngữ cảnh standalone script
  }

  if (!spreadsheet) {
    const customId =
      PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');
    if (customId) {
      spreadsheet = SpreadsheetApp.openById(customId);
    }
  }

  if (!spreadsheet) {
    throw new Error(
      'Không tìm thấy Google Sheet liên kết. Vui lòng mở Apps Script từ menu Tiện ích mở rộng > Apps Script của Google Sheet.'
    );
  }

  const sheet = spreadsheet.getSheets()[0];

  if (!sheet) {
    throw new Error(
      'Không tìm thấy trang tính lưu đăng ký.'
    );
  }

  return sheet;
}


/**
 * Chuẩn hóa cấu trúc Sheet
 * và tạo khóa cho dữ liệu cũ.
 */
function ensureSheetReady_(sheet) {
  const existingHeaders =
    sheet
      .getRange(
        1,
        1,
        1,
        REGISTRATION_HEADERS.length
      )
      .getDisplayValues()[0];

  const needsSetup =
    REGISTRATION_HEADERS.some(
      function (header, index) {
        return (
          existingHeaders[index] !==
          header
        );
      }
    );

  if (!needsSetup) {
    return;
  }

  sheet
    .getRange(
      1,
      1,
      1,
      REGISTRATION_HEADERS.length
    )
    .setValues([
      REGISTRATION_HEADERS
    ])
    .setFontWeight('bold')
    .setFontColor('#ffffff')
    .setBackground('#123f68')
    .setHorizontalAlignment('center')
    .setVerticalAlignment('middle');

  sheet.setFrozenRows(1);
  sheet.setRowHeight(1, 36);

  const widths = [
    175,
    220,
    150,
    245,
    105,
    160,
    135,
    280,
    180,
    285
  ];

  widths.forEach(
    function (width, index) {
      sheet.setColumnWidth(
        index + 1,
        width
      );
    }
  );

  sheet
    .getRange('A:A')
    .setNumberFormat(
      'dd/MM/yyyy HH:mm:ss'
    );

  sheet
    .getRange('B:D')
    .setNumberFormat('@');

  sheet
    .getRange('J:J')
    .setNumberFormat('@');

  sheet
    .getRange('G:G')
    .setNumberFormat(
      '#,##0" đồng"'
    );

  backfillRegistrationKeys_(
    sheet
  );

  /*
   * Cột H là khóa nội bộ.
   */
  try {
    sheet.hideColumns(8);

  } catch (error) {
    console.warn(
      'Không thể ẩn cột khóa đăng ký: ' +
      error.message
    );
  }
}


/**
 * Tạo khóa cho dữ liệu đăng ký cũ.
 */
function backfillRegistrationKeys_(sheet) {
  const lastRow =
    sheet.getLastRow();

  if (lastRow < 2) {
    return;
  }

  const rowCount =
    lastRow - 1;

  const sourceData =
    sheet
      .getRange(
        2,
        2,
        rowCount,
        2
      )
      .getDisplayValues();

  const existingKeys =
    sheet
      .getRange(
        2,
        8,
        rowCount,
        1
      )
      .getDisplayValues();

  let hasChanges = false;

  const output =
    sourceData.map(
      function (row, index) {
        const currentKey =
          normalizeText_(
            existingKeys[index][0]
          );

        if (currentKey) {
          return [
            currentKey
          ];
        }

        const nameKey =
          normalizeNameKey_(
            row[0]
          );

        const phoneKey =
          normalizeVietnamPhone_(
            row[1]
          );

        if (
          !nameKey ||
          !phoneKey
        ) {
          return [''];
        }

        hasChanges = true;

        return [
          createRegistrationKey_(
            nameKey,
            phoneKey
          )
        ];
      }
    );

  if (hasChanges) {
    sheet
      .getRange(
        2,
        8,
        output.length,
        1
      )
      .setValues(
        output
      );
  }
}


/**
 * Kiểm tra khóa trùng trong cột H.
 */
function registrationExists_(
  sheet,
  registrationKey
) {
  const lastRow =
    sheet.getLastRow();

  if (lastRow < 2) {
    return false;
  }

  const found =
    sheet
      .getRange(
        2,
        8,
        lastRow - 1,
        1
      )
      .createTextFinder(
        registrationKey
      )
      .matchEntireCell(true)
      .useRegularExpression(false)
      .findNext();

  return Boolean(found);
}


/**
 * Kiểm tra dữ liệu phía máy chủ.
 */
function validateRegistration_(
  fullName,
  nameKey,
  phone,
  email
) {
  if (
    fullName.length < 2 ||
    fullName.length > 100 ||
    nameKey.length < 2
  ) {
    throw new Error(
      'Vui lòng nhập họ và tên hợp lệ.'
    );
  }

  if (
    !isValidVietnamMobile_(phone)
  ) {
    throw new Error(
      'Số điện thoại phải là số di động Việt Nam gồm 10 chữ số, ' +
      'bắt đầu bằng 03, 05, 07, 08 hoặc 09.'
    );
  }

  if (
    email.length < 5 ||
    email.length > 150 ||
    !isValidEmail_(email)
  ) {
    throw new Error(
      'Vui lòng nhập địa chỉ email hợp lệ.'
    );
  }
}


/**
 * Kiểm tra số di động Việt Nam.
 */
function isValidVietnamMobile_(phone) {
  return /^0(?:3|5|7|8|9)\d{8}$/
    .test(phone);
}


/**
 * Chuẩn hóa:
 *
 * +84 901 234 567
 * 84 901 234 567
 *
 * thành:
 *
 * 0901234567
 */
function normalizeVietnamPhone_(value) {
  let digits =
    String(value || '')
      .replace(/\D/g, '');

  if (
    digits.indexOf('84') === 0 &&
    digits.length === 11
  ) {
    digits =
      '0' +
      digits.substring(2);
  }

  return digits;
}


/**
 * Kiểm tra email.
 */
function isValidEmail_(email) {
  return /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)+$/
    .test(email);
}


/**
 * Kiểm tra email EIU.
 */
function isEiuEmail_(email) {
  return /@eiu\.edu\.vn$/i
    .test(email);
}


/**
 * Early Bird: tính theo ngày giờ Việt Nam, hết hiệu lực lúc
 * 00:00 ngày 26/10/2026 (tức hết ngày 25/10/2026).
 */
function isEarlyBirdActive_(atTime) {
  return Utilities.formatDate(
    atTime || new Date(),
    TUITION_TIMEZONE,
    'yyyyMMdd'
  ) < EARLY_BIRD_END_DATE;
}

/**
 * Nguồn tính giá duy nhất trên server: email EIU giảm thêm 50%
 * trên học phí đang áp dụng (Early Bird hoặc gốc).
 */
function getTuitionInfo_(email, atTime) {
  const isEarlyBird = isEarlyBirdActive_(atTime);
  const isEiu = isEiuEmail_(String(email || '').trim().toLowerCase());
  const baseTuition = isEarlyBird ? EARLY_BIRD_TUITION : STANDARD_TUITION;
  return {
    isEarlyBird: isEarlyBird,
    isEiu: isEiu,
    baseTuition: baseTuition,
    tuition: isEiu ? Math.round(baseTuition * EIU_DISCOUNT_RATE) : baseTuition
  };
}

/**
 * Chuẩn hóa khoảng trắng.
 */
function normalizeText_(value) {
  return String(value || '')
    .replace(/\s+/g, ' ')
    .trim();
}


/**
 * Chuẩn hóa tên để kiểm tra trùng.
 */
function normalizeNameKey_(value) {
  let text =
    normalizeText_(value)
      .toLowerCase();

  try {
    text =
      text
        .normalize('NFD')
        .replace(
          /[\u0300-\u036f]/g,
          ''
        );

  } catch (error) {
    /*
     * Giữ nguyên nếu môi trường
     * không hỗ trợ normalize().
     */
  }

  return text
    .replace(/đ/g, 'd')
    .replace(/[^a-z0-9\s]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
}


/**
 * Tạo khóa kiểm tra trùng.
 */
function createRegistrationKey_(
  nameKey,
  phone
) {
  return (
    nameKey +
    '|' +
    phone
  );
}


/**
 * Ngăn dữ liệu người dùng
 * trở thành công thức trong Sheet.
 */
function safeSheetText_(value) {
  const text =
    String(value || '');

  return /^[=+\-@]/.test(text)
    ? "'" + text
    : text;
}


/**
 * Định dạng học phí.
 */
function formatCurrency_(amount) {
  return (
    Number(amount || 0)
      .toLocaleString('vi-VN') +
    ' đồng'
  );
}


/**
 * Trả về logo đã được nhúng trực tiếp trong Code.gs.
 */
function getLogoDataUrl_() {
  return LOGO_DATA_URL;
}


/**
 * Giữ lại function cũ để không ảnh hưởng
 * đến thao tác hoặc trigger đã có trước đây.
 *
 * Logo hiện không dùng CacheService hoặc Google Drive.
 */
function clearLogoCache() {
  return (
    'Logo EIU đã được nhúng trực tiếp trong Code.gs; ' +
    'không còn bộ nhớ đệm cần xóa.'
